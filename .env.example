NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Contact form (server-only — never prefix these with NEXT_PUBLIC_).
# CONTACT_EMAIL_USER must be a Gmail address with an App Password generated
# for it (Google Account -> Security -> 2-Step Verification -> App Passwords).
CONTACT_EMAIL_USER=
CONTACT_EMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# Cloudinary (server-only — never prefix with NEXT_PUBLIC_). Combined URL format matches the
# `cloudinary` SDK's own auto-config (cloudinary.config() reads CLOUDINARY_URL directly).
# Used by the Gallery admin upload/delete flow (lib/cloudinary.ts).
CLOUDINARY_URL=

# YouTube Data API v3 (server-only). Create/restrict this key in Google Cloud Console to
# "YouTube Data API v3" only. Powers the Gallery's YouTube Playlists tab (lib/youtube.ts).
# The channel ID itself is hardcoded in lib/siteConfig.ts (siteConfig.youtube.channelId)
# since it rarely changes and isn't a secret.
YOUTUBE_API_KEY=

# Firebase Admin service account (server-only). Verifies the admin's ID token before letting
# the Gallery's sign/delete API routes touch Cloudinary (lib/firebaseAdmin.ts). Download from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key, then
# paste the downloaded JSON here as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=
