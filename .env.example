CONTACT_TO_EMAIL=

# Cloudinary â€” used by lib/cloudinary.ts for the Gallery admin upload/delete flow.
# Key "as-salsabil-gallery" (Master Admin role), created via Cloudinary Console -> Settings ->
# API Keys. The prior "Root" key's secret was exposed in chat and has since been deactivated.
CLOUDINARY_URL=

# Firebase Admin SDK service account â€” used by lib/firebaseAdmin.ts to verify the
# admin's ID token on the Gallery API routes (app/api/gallery/sign, app/api/gallery/delete).
# Downloaded from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=
